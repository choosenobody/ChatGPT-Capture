CAPTURE_TOKEN=replace-with-a-long-random-secret
# Container-internal path. Do not change unless you also update the volume mount.
CAPTURE_BUFFER_DIR=/data/chatgpt
# Host directory mounted into the container at /data. The default below is
# what `hermes/setup-cron.sh` writes to ~/.hermes/chatgpt-capture.json, so
# keep them in sync if you customise.
CAPTURE_BUFFER_HOST_DIR=/root/ChatGPT-Capture-Buffer
MAX_MESSAGE_CHARS=120000
