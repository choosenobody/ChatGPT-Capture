{
  "manifest_version": 3,
  "name": "ChatGPT Capture",
  "version": "0.1.0",
  "description": "Capture completed ChatGPT conversation turns and send them privately to your Hermes endpoint.",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ChatGPT Capture"
  }
}
